<?xml version="1.0" encoding="UTF-8"?>
<!-- XmlCraft's built-in German invoice template (written for XmlCraft; MIT OR Apache-2.0). The recipient's address sits in the window
     of a DIN 5008 form B envelope: 45 mm from the top of the page, with the sender's line above it. -->
<invoice-template version="1" page="A4" margin="20mm" font-size="9.5" lang="de">
  <header>
    <block style="heading" align="right">{seller.name}</block>
    <block style="small" align="right">{seller.address.line1} · {seller.address.postcode} {seller.address.city}</block>
  </header>
  <body>
    <columns widths="55% 45%" top="45mm">
      <column>
        <block style="small">{seller.name} · {seller.address.line1} · {seller.address.postcode} {seller.address.city}</block>
        <block/>
        <block>{buyer.name}</block>
        <block if="buyer.contact.name">{buyer.contact.name}</block>
        <block if="buyer.address.line1">{buyer.address.line1}</block>
        <block if="buyer.address.line2">{buyer.address.line2}</block>
        <block if="buyer.address.line3">{buyer.address.line3}</block>
        <block>{buyer.address.postcode} {buyer.address.city}</block>
        <block if="buyer.address.country">{buyer.address.country}</block>
      </column>
      <column>
        <fields>
          <field label="Rechnungsnummer" value="{number}"/>
          <field label="Rechnungsdatum" value="{issue_date|date}"/>
          <field label="Lieferdatum" value="{delivery.date|date}" if="delivery.date"/>
          <field label="Fällig am" value="{due_date|date}" if="due_date"/>
          <field label="Leitweg-ID" value="{buyer.reference}" if="buyer.reference"/>
          <field label="Bestellung" value="{order_reference}" if="order_reference"/>
          <field label="Ansprechpartner" value="{seller.contact.name}" if="seller.contact.name"/>
          <field label="Telefon" value="{seller.contact.phone}" if="seller.contact.phone"/>
          <field label="E-Mail" value="{seller.contact.email}" if="seller.contact.email"/>
        </fields>
      </column>
    </columns>
    <block style="title" top="98mm">{document_name} {number}</block>
    <block if="notes">{notes}</block>
    <block/>
    <table rows="lines" widths="7% 43% 13% 13% 9% 15%">
      <col title="Pos." value="{id}"/>
      <col title="Bezeichnung" value="{name}" sub="{description}"/>
      <col title="Menge" value="{quantity|number} {unit|unit}" align="right"/>
      <col title="Einzelpreis" value="{net_price|money}" align="right"/>
      <col title="USt." value="{vat_rate|percent}" align="right"/>
      <col title="Betrag" value="{line_total|money}" align="right"/>
    </table>
    <block/>
    <table rows="allowances_charges" widths="55% 15% 30%" if="allowances_charges">
      <col title="Nachlass / Zuschlag" value="{reason}"/>
      <col title="USt." value="{vat_rate|percent}" align="right"/>
      <col title="Betrag" value="{amount|money}" align="right"/>
    </table>
    <columns widths="55% 45%">
      <column>
        <table rows="vat_breakdown" widths="18% 22% 30% 30%">
          <col title="Kat." value="{category}"/>
          <col title="Satz" value="{rate|percent}" align="right"/>
          <col title="Netto" value="{taxable|money}" align="right"/>
          <col title="USt." value="{tax|money}" align="right"/>
        </table>
      </column>
      <column>
        <totals/>
      </column>
    </columns>
    <block/>
    <block style="heading" if="payment.iban">Zahlungsinformationen</block>
    <fields>
      <field label="Kontoinhaber" value="{payment.account_name}" if="payment.account_name"/>
      <field label="IBAN" value="{payment.iban}" if="payment.iban"/>
      <field label="BIC" value="{payment.bic}" if="payment.bic"/>
      <field label="Verwendungszweck" value="{payment.reference}" if="payment.reference"/>
      <field label="Mandatsreferenz" value="{payment.mandate}" if="payment.mandate"/>
    </fields>
    <block/>
    <block>{payment_terms}</block>
  </body>
  <footer>
    <block style="small" align="center">{seller.name} · {seller.address.line1} · {seller.address.postcode} {seller.address.city} · USt-IdNr. {seller.vat_id} · {seller.legal_id}</block>
    <block style="small" align="center">Seite {page} von {pages}</block>
  </footer>
</invoice-template>
